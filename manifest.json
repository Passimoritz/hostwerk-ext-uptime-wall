{
  "$schema": "https://raw.githubusercontent.com/Passimoritz/hostwerk-public/main/sdk/manifest.schema.json",
  "id": "uptime-wall",
  "color": "#16a34a",
  "category": "monitoring",
  "name": {
    "de": "Uptime-Wand",
    "en": "Uptime wall"
  },
  "description": {
    "de": "Alle Erreichbarkeits-Prüfungen groß und farbig – mit Verlauf, Verfügbarkeit und Antwortzeit. Für einen zweiten Bildschirm, als Kachel oder als öffentliche Statusseite für deine Besucher.",
    "en": "All uptime checks big and colourful – with history, availability and response time. For a second screen, as a tile or as a public status page for your visitors."
  },
  "permissions": [
    "read:live",
    "share:status"
  ],
  "page": {
    "title": {
      "de": "Uptime-Wand",
      "en": "Uptime wall"
    },
    "description": {
      "de": "Erreichbarkeit aller Überwachungen auf einen Blick.",
      "en": "Uptime of all monitors at a glance."
    },
    "icon": "activity",
    "file": "page/index.html",
    "tabs": [
      {
        "id": "wall",
        "title": {
          "de": "Wand",
          "en": "Wall"
        },
        "icon": "activity"
      },
      {
        "id": "public",
        "title": {
          "de": "Öffentliche Statusseite",
          "en": "Public status page"
        },
        "icon": "globe"
      }
    ]
  },
  "widget": {
    "title": {
      "de": "Uptime-Wand",
      "en": "Uptime wall"
    },
    "file": "widget/index.html",
    "size": "third"
  },
  "version": "1.2.0",
  "author": "Hostwerk",
  "homepage": "https://github.com/Passimoritz/hostwerk-ext-uptime-wall",
  "license": "MIT",
  "icon": "icon.svg",
  "banner": "banner.svg",
  "hostwerk": ">=2.9.0"
}
